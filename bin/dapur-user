#!/usr/bin/env php
<?php

/**
 * Perintah modul user Dapur AdeMS. Jalankan dari folder inti:
 *
 *   vendor/bin/dapur-user pasang
 *   vendor/bin/dapur-user buat-admin <email> [--nama="Nama Lengkap"]
 *   vendor/bin/dapur-user ganti-sandi <email>
 *   vendor/bin/dapur-user riwayat <email> [--jumlah=20]
 *   vendor/bin/dapur-user daftar-akses [<email>]
 *   vendor/bin/dapur-user cabut-akses <email>
 *   vendor/bin/dapur-user riwayat-akun [<email>] [--jumlah=20]
 */

declare(strict_types=1);

use AdeMS\Dapur\User\DaftarUser;
use AdeMS\Dapur\User\Konteks;
use AdeMS\Dapur\User\Pengaturan;
use AdeMS\Dapur\User\Perintah;
use AdeMS\Dapur\User\RiwayatAkun;
use AdeMS\Dapur\User\RiwayatMasuk;
use Laminas\Db\Adapter\Adapter;

require $GLOBALS['_composer_autoload_path'] ?? dirname(__DIR__, 3) . '/autoload.php';

$bacaSandi = static function (string $pesan): string {
    $tersembunyi = stream_isatty(STDIN);

    echo $pesan;
    if ($tersembunyi) {
        shell_exec('stty -echo');
    }

    $baris = fgets(STDIN);

    if ($tersembunyi) {
        shell_exec('stty echo');
        echo PHP_EOL;
    }

    return rtrim((string) $baris, "\r\n");
};

// Pertanyaan ya/tidak hanya diajukan bila dijalankan di terminal; dari skrip tidak ada yang ditanyakan.
$tanya = stream_isatty(STDIN)
    ? static function (string $pesan): string {
        echo $pesan;

        return rtrim((string) fgets(STDIN), "\r\n");
    }
    : null;

$argumen = array_values(array_slice($argv, 1));

try {
    chdir(Konteks::folderInti());

    $container = require 'config/container.php';
    $db        = $container->get(Adapter::class);
    $atur      = new Pengaturan($container->get('config')['user'] ?? []);
    $riwayat   = new RiwayatMasuk($db, $atur->tabel, $atur->riwayatHari);
    $perintah  = new Perintah($db, new DaftarUser($db, $atur->tabel), $bacaSandi(...), Konteks::lingkup(), $tanya, $atur->tabel, $riwayat, $atur->zonaWaktu, new RiwayatAkun($db, $atur->tabel));

    exit($perintah->jalankan($argumen));
} catch (Throwable $e) {
    while ($e->getPrevious() !== null) {
        $e = $e->getPrevious();
    }

    fwrite(STDERR, 'Gagal: ' . $e->getMessage() . PHP_EOL);
    exit(1);
}
