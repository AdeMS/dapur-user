{
    "name": "adems/dapur-user",
    "description": "Modul user untuk Dapur AdeMS: akun, login, hak akses, riwayat login, dan email undangan serta lupa kata sandi",
    "type": "library",
    "license": "BSD-3-Clause",
    "keywords": [
        "dapur",
        "adems",
        "laminas",
        "mezzio",
        "user",
        "login"
    ],
    "homepage": "https://www.adems.id",
    "authors": [
        {
            "name": "Ade M Saragih",
            "homepage": "https://www.adems.id"
        }
    ],
    "require": {
        "php": "~8.2.0 || ~8.3.0 || ~8.4.0 || ~8.5.0",
        "ext-session": "*",
        "adems/dapur-email": "^1.0",
        "composer-runtime-api": "^2.0",
        "laminas/laminas-db": "^2.22",
        "laminas/laminas-diactoros": "^3.9",
        "mezzio/mezzio-template": "^3.0",
        "psr/container": "^1.1 || ^2.0",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0"
    },
    "require-dev": {
        "adems/dapur-multiwebsite": "^1.1",
        "phpunit/phpunit": "^11.5"
    },
    "suggest": {
        "adems/dapur-dashboard": "Dashboard yang memakai login dari paket ini",
        "adems/dapur-multiwebsite": "Diperlukan untuk hak akses dan session per website"
    },
    "autoload": {
        "psr-4": {
            "AdeMS\\Dapur\\User\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AdeMS\\Dapur\\User\\Test\\": "test/"
        }
    },
    "bin": [
        "bin/dapur-user"
    ],
    "scripts": {
        "test": "phpunit"
    }
}
