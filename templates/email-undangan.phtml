<?php
/**
 * Email undangan user baru (HTML). Dibungkus layout email::layout dari adems/dapur-email.
 *
 * @var string $nama
 * @var string $tautan
 * @var string $pengundang
 * @var string $namaWebsite
 * @var int $jam
 */
?>
<p style="margin:0 0 12px;">Halo <?= $this->escapeHtml($this->nama) ?>,</p>
<p style="margin:0 0 12px;"><?= $this->escapeHtml($this->pengundang) ?> mengundang Anda ke <strong><?= $this->escapeHtml($this->namaWebsite) ?></strong>. Buat kata sandi Anda lewat tombol berikut:</p>
<p style="margin:20px 0;"><a href="<?= $this->escapeHtmlAttr($this->tautan) ?>" style="display:inline-block;padding:12px 24px;background:#198754;color:#ffffff;text-decoration:none;border-radius:8px;font-weight:bold;">Buat kata sandi</a></p>
<p style="margin:0 0 12px;font-size:13px;color:#5c6b63;">Tautan berlaku <?= (int) $this->jam ?> jam dan hanya bisa dipakai sekali. Bila tombol tidak berfungsi, salin alamat ini ke browser:<br><span style="word-break:break-all;"><?= $this->escapeHtml($this->tautan) ?></span></p>
<p style="margin:0;font-size:13px;color:#5c6b63;">Bila Anda tidak mengenal pengirim undangan ini, abaikan saja email ini.</p>
