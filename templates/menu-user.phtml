<?php $this->placeholder('menu-kanan')->captureStart() ?>
                            <li class="nav-item dropdown">
                                <button class="btn btn-link nav-link dropdown-toggle d-flex align-items-center" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Menu user <?= $this->escapeHtmlAttr($namaMenu) ?>">
                                    <?= $avatar() ?>
