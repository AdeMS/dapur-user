                                            <div class="fw-semibold"><?= $this->escapeHtml($namaMenu) ?></div>
                                            <div class="small text-body-secondary"><?= $this->escapeHtml($identitas?->email ?? $this->emailTampil ?? $this->user->email) ?></div>
                                        </div>
                                    </li>
<?php
// Status: tampil di bawah nama; tanpa status, ajakan "Atur status". Bila halaman Pengaturan & Privasi ada, status
// bisa langsung diketik di sini (dan di kartu Profil sendiri): klik, ketik, Enter simpan, Esc batal.
$statusMenu    = $identitas?->status ?? '';
$alamatStatus  = ($this->alamatPengaturan ?? null) ? $this->alamatPengaturan . '?tab=profil' : null;
?>
<?php if ($alamatStatus !== null && $identitas !== null) : ?>
                                    <li><button type="button" class="dropdown-item user-menu-status<?= $statusMenu === '' ? ' text-body-secondary' : '' ?>" data-status-ubah data-status="<?= $this->escapeHtmlAttr($statusMenu) ?>" title="Klik untuk mengubah status"><?php if ($statusMenu !== '') : ?><i class="bi bi-chat-quote me-2 text-body-secondary" aria-hidden="true"></i><span class="visually-hidden">Status: </span><em><?= $this->escapeHtml($statusMenu) ?></em><?php else : ?><i class="bi bi-chat-quote me-2" aria-hidden="true"></i>Atur status…<?php endif ?></button></li>
<?php elseif ($statusMenu !== '') : ?>
                                    <li><span class="dropdown-item-text user-menu-status"><i class="bi bi-chat-quote me-2 text-body-secondary" aria-hidden="true"></i><span class="visually-hidden">Status: </span><em><?= $this->escapeHtml($statusMenu) ?></em></span></li>
<?php endif ?>
