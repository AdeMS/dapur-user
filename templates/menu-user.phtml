                                        <form method="post" action="<?= $this->escapeHtmlAttr($this->alamatKeluar) ?>">
                                            <input type="hidden" name="<?= $this->escapeHtmlAttr($this->fieldCsrf) ?>" value="<?= $this->escapeHtmlAttr($this->tokenCsrf) ?>">
                                            <button type="submit" class="dropdown-item"><i class="bi bi-box-arrow-right me-2"></i>Keluar</button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
<?php $this->placeholder('menu-kanan')->captureEnd() ?>
<?php if ($alamatStatus !== null && $identitas !== null) : ?>
<script>
(() => {
    if (window.dapurUbahStatus) {
        return;
    }
    window.dapurUbahStatus = true;
    const alamat = <?= json_encode($this->alamatPengaturan) ?>;
    const csrfNama = <?= json_encode($this->fieldCsrf) ?>;
    const csrf = <?= json_encode($this->tokenCsrf) ?>;
    const aman = (s) => { const d = document.createElement('div'); d.textContent = s; return d.innerHTML; };
    const isiTampil = (teks) => teks !== ''
        ? '<i class="bi bi-chat-quote me-2 text-body-secondary" aria-hidden="true"></i><span class="visually-hidden">Status: </span><em>' + aman(teks) + '</em>'
        : '<i class="bi bi-chat-quote me-2" aria-hidden="true"></i>Atur status…';

    const mulai = (el) => {
        el.dataset.sedang = '1';
        const asal = el.innerHTML;
        const nilai = el.dataset.status || '';
        const isian = document.createElement('input');
        isian.className = 'form-control form-control-sm';
        isian.maxLength = 100;
        isian.value = nilai;
        isian.placeholder = 'Status saat ini…';
        isian.setAttribute('aria-label', 'Status');
        el.replaceChildren(isian);
        isian.focus();
        isian.select();
        let selesai = false;
        const tutup = (html) => { selesai = true; el.innerHTML = html; delete el.dataset.sedang; };
        const simpan = async () => {
            if (selesai) {
                return;
            }
            const teks = isian.value.trim();
            if (teks === nilai) {
                tutup(asal);
                return;
            }
            selesai = true;
            const form = new FormData();
            form.append(csrfNama, csrf);
            form.append('aksi', 'status');
            form.append('status', teks);
            form.append('json', '1');
            try {
                const jawab = await fetch(alamat, { method: 'POST', body: form, credentials: 'same-origin' });
                const isi = await jawab.json().catch(() => ({ galat: 'Server menjawab ' + jawab.status + '.' }));
                if (!jawab.ok || isi.galat) {
                    throw new Error(isi.galat || 'Status tidak tersimpan.');
                }
                // Perbarui semua tampilan status di halaman ini (menu avatar dan kartu Profil).
                document.querySelectorAll('[data-status-ubah]').forEach((x) => {
                    x.dataset.status = isi.status;
                    x.classList.toggle('text-body-secondary', isi.status === '');
                    if (x !== el) { x.innerHTML = isiTampil(isi.status); }
                });
                el.innerHTML = isiTampil(isi.status);
                delete el.dataset.sedang;
            } catch (err) {
                selesai = false;
                isian.classList.add('is-invalid');
                isian.title = err.message;
                isian.focus();
            }
        };
        isian.addEventListener('click', (e) => e.stopPropagation());
        isian.addEventListener('keydown', (e) => {
            e.stopPropagation();
            if (e.key === 'Enter') { e.preventDefault(); simpan(); }
            if (e.key === 'Escape') { e.preventDefault(); tutup(asal); }
        });
        isian.addEventListener('blur', () => simpan());
    };

    document.addEventListener('click', (e) => {
        const el = e.target.closest('[data-status-ubah]');
        if (!el || el.dataset.sedang) {
            return;
        }
        e.preventDefault();
        e.stopPropagation(); // menu avatar tetap terbuka selama mengetik
        mulai(el);
    }, true);
})();
</script>
<?php endif ?>
