/**
 * Menu user di navbar. Tidak menghasilkan keluaran di halaman: isinya dikirim ke placeholder 'menu-kanan'
 * pada layout Dapur (avatar inisial dengan submenu berisi avatar, nama, email, Profil, Pengaturan & Privasi, dan
 * tombol keluar).
 *
 * Panggil dari template modul: $this->partial('user::menu-user', [...]).
 *
 * @var AdeMS\Dapur\User\User $user
 * @var string|null $emailTampil  email yang ditampilkan (email website ini); bawaan email utama
 * @var AdeMS\Dapur\User\Identitas|null $identitas  nama, email, dan foto di website ini; bawaan data akun
 * @var string $alamatKeluar
 * @var string|null $alamatProfil  tautan Profil di submenu; tidak ditampilkan bila tidak diberikan
 * @var string|null $alamatPengaturan  tautan Pengaturan & Privasi; tidak ditampilkan bila tidak diberikan
 * @var string $tokenCsrf
 * @var string $fieldCsrf
 */
$identitas = $this->identitas ?? null;
$namaMenu  = $identitas?->nama ?? $this->user->nama;
$avatar    = fn (string $kelas = ''): string => $this->partial('user::avatar', [
    'foto'    => $identitas?->foto,
    'inisial' => $identitas?->inisial ?? $this->user->inisial(),
    'kelas'   => $kelas,
]);
?>
