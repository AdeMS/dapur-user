<?php if ($this->alamatProfil ?? null) : ?>
                                    <li><a class="dropdown-item" href="<?= $this->escapeHtmlAttr($this->alamatProfil) ?>"><i class="bi bi-person-circle me-2"></i>Profil</a></li>
<?php endif ?>
<?php if ($this->alamatPengaturan ?? null) : ?>
                                    <li><a class="dropdown-item" href="<?= $this->escapeHtmlAttr($this->alamatPengaturan) ?>"><i class="bi bi-gear me-2"></i>Pengaturan &amp; Privasi</a></li>
<?php endif ?>
<?php if (($this->alamatProfil ?? null) || ($this->alamatPengaturan ?? null)) : ?>
