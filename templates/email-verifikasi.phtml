<?php
/**
 * Email verifikasi email baru (HTML), dikirim ke alamat baru.
 *
 * @var string $nama
 * @var string $emailBaru
 * @var bool $tambah  menambah email ke akun (bukan mengganti email utama)
 * @var string $tautan
 * @var string $namaWebsite
 * @var int $jam
 */
?>
<p style="margin:0 0 12px;">Halo <?= $this->escapeHtml($this->nama) ?>,</p>
<?php if ($this->tambah ?? false) : ?>
<p style="margin:0 0 12px;">Anda meminta agar <strong><?= $this->escapeHtml($this->emailBaru) ?></strong> ditambahkan ke akun Anda di <strong><?= $this->escapeHtml($this->namaWebsite) ?></strong>. Konfirmasi lewat tombol berikut:</p>
<?php else : ?>
<p style="margin:0 0 12px;">Anda meminta agar email akun Anda di <strong><?= $this->escapeHtml($this->namaWebsite) ?></strong> diganti menjadi <strong><?= $this->escapeHtml($this->emailBaru) ?></strong>. Konfirmasi lewat tombol berikut:</p>
<?php endif ?>
<p style="margin:20px 0;"><a href="<?= $this->escapeHtmlAttr($this->tautan) ?>" style="display:inline-block;padding:12px 24px;background:#198754;color:#ffffff;text-decoration:none;border-radius:8px;font-weight:bold;">Konfirmasi email baru</a></p>
<p style="margin:0 0 12px;font-size:13px;color:#5c6b63;">Tautan berlaku <?= (int) $this->jam ?> jam dan hanya bisa dipakai sekali. Bila tombol tidak berfungsi, salin alamat ini ke browser:<br><span style="word-break:break-all;"><?= $this->escapeHtml($this->tautan) ?></span></p>
<p style="margin:0;font-size:13px;color:#5c6b63;">Bila bukan Anda yang memintanya, abaikan email ini. Akun tidak berubah.</p>
