 */
?>
<p style="margin:0 0 12px;">Halo,</p>
<p style="margin:0 0 12px;"><strong><?= $this->escapeHtml($this->nama) ?></strong> (<?= $this->escapeHtml($this->emailAkun) ?>) meminta agar akun <strong><?= $this->escapeHtml($this->emailB) ?></strong> di <strong><?= $this->escapeHtml($this->namaWebsite) ?></strong> digabungkan ke akunnya.</p>
<p style="margin:0 0 12px;">Bila digabung, email ini menjadi email tambahan akun tersebut, akses website akun ini ikut pindah, dan akun ini ditutup. <strong>Penggabungan tidak bisa dibatalkan.</strong> Lanjutkan hanya bila kedua akun memang milik Anda:</p>
