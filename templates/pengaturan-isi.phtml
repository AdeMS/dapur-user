// 'website'; $foto = alamat foto yang sedang tampil (bisa foto akun di bagian website); $adaSendiri = ada foto yang
// bisa dihapus di bagian ini.
$pemilihFoto = function (string $untuk, ?string $foto, bool $adaSendiri) use (&$aksi, &$csrf): string {
    $id     = 'pengaturan-foto-' . $untuk;
    $avatar = $this->partial('user::avatar', ['foto' => $foto, 'inisial' => $this->inisialAkun ?? $this->user->inisial(), 'kelas' => 'user-pengaturan-avatar']);
    $h  = '<div class="dropdown user-foto-pemilih">'
        . '<button type="button" class="user-foto-tombol" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Ubah foto" title="Ubah foto">'
        . $avatar
        . '<span class="user-foto-lapis" aria-hidden="true"><i class="bi bi-camera"></i><span>Ubah foto</span></span>'
        . '<span class="user-foto-lencana" aria-hidden="true"><i class="bi bi-camera-fill"></i></span>'
        . '</button><ul class="dropdown-menu">';
    if ($foto !== null) {
        $h .= '<li><button type="button" class="dropdown-item" data-user-foto-lihat="' . $this->escapeHtmlAttr($foto) . '"><i class="bi bi-eye me-2" aria-hidden="true"></i>Lihat foto</button></li>';
    }
    $h .= '<li class="user-foto-kamera d-none"><button type="button" class="dropdown-item" data-user-foto-kamera="' . $id . '"><i class="bi bi-camera me-2" aria-hidden="true"></i>Ambil foto</button></li>'
        . '<li><label class="dropdown-item" for="' . $id . '" role="button"><i class="bi bi-folder2-open me-2" aria-hidden="true"></i>Unggah foto</label></li>';
    if ($adaSendiri) {
        $h .= '<li><hr class="dropdown-divider"></li>'
            . '<li><button type="submit" class="dropdown-item text-danger" form="' . $id . '-hapus"><i class="bi bi-trash me-2" aria-hidden="true"></i>Hapus foto</button></li>';
    }
    $h .= '</ul></div>';
    $h .= '<form method="post" action="' . $aksi . '" enctype="multipart/form-data" class="d-none">' . $csrf
        . '<input type="hidden" name="aksi" value="foto"><input type="hidden" name="untuk" value="' . $untuk . '">'
        . '<input type="file" id="' . $id . '" name="foto" accept="image/jpeg,image/png,image/webp" data-user-foto-unggah></form>';
    if ($adaSendiri) {
        $h .= '<form method="post" action="' . $aksi . '" id="' . $id . '-hapus" class="d-none" onsubmit="return confirm(\'Hapus foto ini?\')">' . $csrf
            . '<input type="hidden" name="aksi" value="hapus_foto"><input type="hidden" name="untuk" value="' . $untuk . '"></form>';
    }

    return $h;
};
