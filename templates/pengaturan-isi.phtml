<?php if ($alamatLokasi !== null && $profilSiap) : ?>
    // Saran kota untuk Lokasi: ketik minimal 2 huruf, pilih dengan klik atau panah + Enter. Memilih saran mengisi
    // nomor kota (lokasi_id); mengubah teks sesudahnya menjadikan Lokasi teks bebas lagi.
    document.querySelectorAll('[data-user-lokasi]').forEach((wadah) => {
        const masukan = wadah.querySelector('input[name=lokasi]');
        const nomor   = wadah.querySelector('input[name=lokasi_id]');
        const daftar  = wadah.querySelector('ul');
        let pilihan = [];
        let aktif   = -1;
        let jeda    = null;
        let urutan  = 0;

        const tutup = () => {
            daftar.classList.remove('show');
            daftar.replaceChildren();
            masukan.setAttribute('aria-expanded', 'false');
            masukan.removeAttribute('aria-activedescendant');
            pilihan = [];
            aktif = -1;
        };
        const tandai = (i) => {
            aktif = i;
            daftar.querySelectorAll('.dropdown-item').forEach((el, j) => {
                el.classList.toggle('active', j === i);
                el.setAttribute('aria-selected', j === i ? 'true' : 'false');
            });
            if (i >= 0) {
                masukan.setAttribute('aria-activedescendant', 'pengaturan-lokasi-' + i);
                daftar.children[i].scrollIntoView({ block: 'nearest' });
            }
        };
        const pilih = (i) => {
            masukan.value = pilihan[i].teks;
            nomor.value   = String(pilihan[i].id);
            tutup();
        };
        const tampilkan = (hasil) => {
            daftar.replaceChildren();
            pilihan = hasil;
            aktif = -1;
            if (hasil.length === 0) {
                tutup();
                return;
            }
            hasil.forEach((h, i) => {
                const li = document.createElement('li');
                const tombol = document.createElement('button');
                tombol.type = 'button';
                tombol.className = 'dropdown-item';
                tombol.id = 'pengaturan-lokasi-' + i;
                tombol.setAttribute('role', 'option');
                tombol.setAttribute('aria-selected', 'false');
                tombol.tabIndex = -1;
                tombol.textContent = h.teks;
                // mousedown agar terpilih sebelum isian kehilangan fokus
                tombol.addEventListener('mousedown', (e) => { e.preventDefault(); pilih(i); });
                li.appendChild(tombol);
                daftar.appendChild(li);
            });
            daftar.classList.add('show');
            masukan.setAttribute('aria-expanded', 'true');
        };
        const cari = async () => {
            const teks = masukan.value.trim();
            const ke = ++urutan;
            if (teks.length < 2) {
                tutup();
                return;
            }
            try {
                const jawab = await fetch(wadah.dataset.userLokasi + '?cari=' + encodeURIComponent(teks), {
                    headers: { Accept: 'application/json' },
                    credentials: 'same-origin',
                });
                if (! jawab.ok) {
                    tutup();
                    return;
                }
                const data = await jawab.json();
                if (ke === urutan && document.activeElement === masukan) {
                    tampilkan(Array.isArray(data.hasil) ? data.hasil : []);
                }
            } catch (e) {
                tutup();
            }
        };

        masukan.addEventListener('input', () => {
            nomor.value = '';
            clearTimeout(jeda);
            jeda = setTimeout(cari, 300);
        });
        masukan.addEventListener('keydown', (e) => {
            if (pilihan.length === 0) {
                return;
            }
            if (e.key === 'ArrowDown') {
                e.preventDefault();
                tandai((aktif + 1) % pilihan.length);
            } else if (e.key === 'ArrowUp') {
                e.preventDefault();
                tandai(aktif <= 0 ? pilihan.length - 1 : aktif - 1);
            } else if (e.key === 'Enter' && aktif >= 0) {
                e.preventDefault();
                pilih(aktif);
            } else if (e.key === 'Escape') {
                tutup();
            }
        });
        masukan.addEventListener('blur', () => setTimeout(tutup, 150));
    });
