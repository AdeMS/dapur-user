    (() => {
        const UKURAN_MAKS = <?= \AdeMS\Dapur\User\FotoUser::UKURAN_MAKS ?>;
        const galat = (id, teks) => {
            document.querySelectorAll('.user-foto-galat[data-untuk="' + id + '"]').forEach((el) => { el.textContent = teks; });
        };
        // Unggah langsung saat file dipilih; file di atas 2 MB ditolak di browser agar tidak perlu dikirim dulu.
        document.querySelectorAll('[data-user-foto-unggah]').forEach((masukan) => {
            masukan.addEventListener('change', () => {
                const file = masukan.files[0];
                if (! file) {
                    return;
                }
                if (file.size > UKURAN_MAKS) {
                    galat(masukan.id, 'Foto terlalu besar (' + (file.size / 1048576).toFixed(1) + ' MB); paling besar 2 MB.');
                    masukan.value = '';
                    return;
                }
                galat(masukan.id, '');
                masukan.form.submit();
            });
        });

        // Lihat foto
        const popupLihat = document.getElementById('user-foto-popup-lihat');
        document.querySelectorAll('[data-user-foto-lihat]').forEach((tombol) => {
            tombol.addEventListener('click', () => {
                popupLihat.querySelector('img').src = tombol.dataset.userFotoLihat;
                bootstrap.Modal.getOrCreateInstance(popupLihat).show();
            });
        });

        // Ambil foto dari kamera (butuh HTTPS dan izin kamera). Hasilnya dipotong persegi di tengah lalu dikirim
        // seperti file unggahan biasa, jadi server tetap memeriksa dan membuat ulang gambarnya.
        const popupKamera = document.getElementById('user-foto-popup-kamera');
        if (! navigator.mediaDevices || ! navigator.mediaDevices.getUserMedia || typeof DataTransfer === 'undefined') {
            return;
        }
        document.querySelectorAll('.user-foto-kamera').forEach((li) => li.classList.remove('d-none'));
        const video  = popupKamera.querySelector('video');
        const kanvas = popupKamera.querySelector('canvas');
        const pesan  = popupKamera.querySelector('.user-foto-kamera-pesan');
        const tombol = (nama) => popupKamera.querySelector('[data-user-kamera="' + nama + '"]');
        let aliran = null;
        let tujuan = null;
        const tampilan = (jepretan) => {
            video.classList.toggle('d-none', jepretan);
            kanvas.classList.toggle('d-none', ! jepretan);
            tombol('jepret').classList.toggle('d-none', jepretan);
            tombol('ulang').classList.toggle('d-none', ! jepretan);
            tombol('pakai').classList.toggle('d-none', ! jepretan);
        };
        const berhenti = () => {
            if (aliran) {
                aliran.getTracks().forEach((t) => t.stop());
                aliran = null;
            }
            video.srcObject = null;
        };
        document.querySelectorAll('[data-user-foto-kamera]').forEach((pemicu) => {
            pemicu.addEventListener('click', () => {
                tujuan = document.getElementById(pemicu.dataset.userFotoKamera);
                tampilan(false);
                tombol('jepret').disabled = true;
                pesan.textContent = 'Izinkan browser memakai kamera.';
                bootstrap.Modal.getOrCreateInstance(popupKamera).show();
                navigator.mediaDevices.getUserMedia({ video: { facingMode: 'user', width: { ideal: 1280 }, height: { ideal: 1280 } }, audio: false })
                    .then((a) => {
                        aliran = a;
                        video.srcObject = a;
                        tombol('jepret').disabled = false;
                        pesan.textContent = 'Posisikan wajah di tengah lingkaran, lalu klik Ambil.';
                    })
                    .catch(() => { pesan.textContent = 'Kamera tidak bisa dibuka. Periksa izin kamera di browser, atau pakai Unggah foto.'; });
            });
        });
        tombol('jepret').addEventListener('click', () => {
            const sisi = Math.min(video.videoWidth, video.videoHeight);
            if (! sisi) {
                return;
            }
            const hasil = Math.min(sisi, 1024);
            kanvas.width = kanvas.height = hasil;
            const k = kanvas.getContext('2d');
            // Disimpan seperti yang terlihat di layar (dicerminkan), sama seperti swafoto di kamera ponsel.
            k.translate(hasil, 0);
            k.scale(-1, 1);
            k.drawImage(video, (video.videoWidth - sisi) / 2, (video.videoHeight - sisi) / 2, sisi, sisi, 0, 0, hasil, hasil);
            tampilan(true);
            pesan.textContent = 'Pakai foto ini?';
        });
        tombol('ulang').addEventListener('click', () => { tampilan(false); pesan.textContent = 'Posisikan wajah di tengah lingkaran, lalu klik Ambil.'; });
        tombol('pakai').addEventListener('click', () => {
            tombol('pakai').disabled = true;
            kanvas.toBlob((blob) => {
                const dt = new DataTransfer();
                dt.items.add(new File([blob], 'kamera.jpg', { type: 'image/jpeg' }));
                tujuan.files = dt.files;
                berhenti();
                tujuan.form.submit();
            }, 'image/jpeg', 0.9);
        });
        popupKamera.addEventListener('hidden.bs.modal', () => { berhenti(); tombol('pakai').disabled = false; });
    })();
<?php endif ?>
</script>
