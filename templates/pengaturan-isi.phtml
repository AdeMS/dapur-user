// Tombol "Tampilkan lebih banyak": muat ulang tab ini dengan lebih banyak baris, lalu lompat ke baris baru pertama.
$tombolLagi = function (string $tab, ?int $jumlah, int $sekarang): string {
    if ($jumlah === null) {
        return '';
    }
    $alamat = $this->alamatPengaturan . '?tab=' . $tab . '&jumlah=' . $jumlah . '#' . $tab . '-' . $sekarang;

    return '<div class="text-center mt-3"><a class="btn btn-outline-success" href="' . $this->escapeHtmlAttr($alamat)
        . '"><i class="bi bi-chevron-double-down me-1"></i>Tampilkan lebih banyak</a></div>';
};
