    'masuk'       => 'success',
    'gagal'       => 'danger',
    'keluar'      => 'secondary',
    'ganti_sandi' => 'warning',
    'ditolak_domain' => 'warning',
];
$warnaAkun = [
    'buat_user'   => 'success',
    'beri_akses'  => 'success',
    'ubah_peran'  => 'info',
    'ubah_nama'   => 'secondary',
    'cabut_akses' => 'danger',
    'aktifkan'    => 'success',
    'nonaktifkan' => 'warning',
    'undang'      => 'info',
    'ubah_email'  => 'secondary',
    'tambah_email'  => 'secondary',
    'hapus_email'   => 'secondary',
    'email_utama'   => 'secondary',
    'email_website' => 'secondary',
];
