$tab       = isset($tabs[$this->tab ?? '']) ? $this->tab : 'akun';
$galatDi   = fn (string $bagian): bool => $this->galat && $this->galatBagian === $bagian;
$daftarEmail = $this->daftarEmail ?? [];
$popupBuka = match (true) {
    $galatDi('sandi')                     => 'sandi',
    $galatDi('email') && $bisaEmail        => 'email',
    $galatDi('tambah_email') && $bisaEmail => 'tambah-email',
    default                               => null,
};
// Email yang sedang dipakai di website ini: pilihan user, atau email utama.
$emailWebsiteId = $this->emailWebsiteId ?? null;
foreach ($daftarEmail as $e) {
    if ($emailWebsiteId === null && $e['utama']) {
        $emailWebsiteId = $e['id'];
    }
}
// Tombol "Tampilkan lebih banyak": muat ulang tab ini dengan lebih banyak baris, lalu lompat ke baris baru pertama.
$tombolLagi = function (string $tab, ?int $jumlah, int $sekarang): string {
    if ($jumlah === null) {
        return '';
    }
    $alamat = $this->alamatPengaturan . '?tab=' . $tab . '&jumlah=' . $jumlah . '#' . $tab . '-' . $sekarang;

    return '<div class="text-center mt-3"><a class="btn btn-outline-success" href="' . $this->escapeHtmlAttr($alamat)
        . '"><i class="bi bi-chevron-double-down me-1"></i>Tampilkan lebih banyak</a></div>';
};
$csrf = '<input type="hidden" name="' . $this->escapeHtmlAttr($this->fieldCsrf) . '" value="'
    . $this->escapeHtmlAttr($this->tokenCsrf) . '">';
?>
