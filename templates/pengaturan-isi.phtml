<script>
    // Tab yang dibuka ikut tercatat di alamat (?tab=...), agar tetap terbuka saat halaman dimuat ulang.
    document.querySelectorAll('.user-pengaturan [data-tab]').forEach((tombol) => {
        tombol.addEventListener('shown.bs.tab', () => {
            const alamat = new URL(window.location.href);
            alamat.searchParams.set('tab', tombol.dataset.tab);
            history.replaceState(null, '', alamat);
        });
    });
<?php if ($popupBuka !== null) : ?>
    // Form di popup gagal dikirim: buka lagi popup itu bersama pesannya. Bootstrap dimuat di akhir halaman, jadi
    // tunggu sampai halaman selesai dimuat.
    document.addEventListener('DOMContentLoaded', () => {
        bootstrap.Modal.getOrCreateInstance(document.getElementById('pengaturan-popup-<?= $popupBuka ?>')).show();
    });
<?php endif ?>
</script>
