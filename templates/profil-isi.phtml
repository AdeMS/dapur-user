<?php
/**
 * Isi halaman profil: kartu user (avatar, nama, email, peran, status), hanya untuk dibaca. Nama, email, kata
 * sandi, aktivitas, dan riwayat masuk diatur di halaman Pengaturan & Privasi (user::pengaturan-isi), yang
 * tautannya ada di kartu ini.
 *
 * @var AdeMS\Dapur\User\User $user
 * @var string|null $pesan        pesan berhasil
 * @var string|null $galat        pesan kesalahan
 * @var array{nilai: string, label: string}|null $peran  peran di lingkup ini
 * @var bool $aktif
 * @var string|null $alamatPengaturan
 */
$warnaPeran = [
    'admin_super' => 'warning',
    'admin_web'   => 'primary',
    'anggota'     => 'secondary',
];
$peran = $this->peran ?? null;
$aktif = $this->aktif ?? true;
?>
<style>
    .user-profil-avatar { width: 6rem; height: 6rem; font-size: 2.25rem; }
    .user-profil-data dt { font-weight: 500; }
</style>
<div class="container py-4 user-profil">
    <div class="card mb-4">
        <div class="card-body py-3">
            <h1 class="h4 mb-0">Profil</h1>
        </div>
    </div>
<?php if ($this->pesan ?? null) : ?>
    <div class="alert alert-success alert-dismissible fade show user-pesan-sementara" role="status">
        <?= $this->escapeHtml($this->pesan) ?>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Tutup"></button>
    </div>
    <script>
        // Pesan berhasil tertutup sendiri setelah 10 detik. Bootstrap dimuat di akhir halaman, jadi tunggu sampai
        // halaman selesai dimuat.
        document.addEventListener('DOMContentLoaded', () => {
            setTimeout(() => {
                document.querySelectorAll('.user-pesan-sementara').forEach((pesan) => bootstrap.Alert.getOrCreateInstance(pesan).close());
            }, 10000);
        });
    </script>
<?php endif ?>
<?php if ($this->galat ?? null) : ?>
    <div class="alert alert-danger" role="alert"><?= $this->escapeHtml($this->galat) ?></div>
<?php endif ?>
    <div class="row">
        <div class="col-12 col-md-8 col-lg-6 col-xl-5">
            <div class="card">
                <div class="card-body">
                    <div class="text-center mb-3">
                        <span class="user-avatar user-profil-avatar mb-3" aria-hidden="true"><?= $this->escapeHtml($this->user->inisial()) ?></span>
                        <h2 class="h5 mb-0"><?= $this->escapeHtml($this->user->nama) ?></h2>
                        <div class="text-body-secondary text-break"><?= $this->escapeHtml($this->user->email) ?></div>
                    </div>
                    <dl class="user-profil-data mb-3">
<?php if ($peran) : ?>
                        <div class="d-flex justify-content-between align-items-center border-bottom py-2">
                            <dt>Peran</dt>
                            <dd class="mb-0"><span class="badge text-bg-<?= $this->escapeHtmlAttr($warnaPeran[$peran['nilai']] ?? 'info') ?>"><?= $this->escapeHtml($peran['label']) ?></span></dd>
                        </div>
<?php endif ?>
                        <div class="d-flex justify-content-between align-items-center border-bottom py-2">
                            <dt>Status</dt>
                            <dd class="mb-0"><span class="badge text-bg-<?= $aktif ? 'success' : 'secondary' ?>"><?= $aktif ? 'Aktif' : 'Nonaktif' ?></span></dd>
                        </div>
                    </dl>
<?php if ($this->alamatPengaturan ?? null) : ?>
                    <a class="btn btn-success w-100" href="<?= $this->escapeHtmlAttr($this->alamatPengaturan . '?tab=akun') ?>"><i class="bi bi-gear me-2"></i>Pengaturan akun</a>
<?php endif ?>
                </div>
            </div>
        </div>
    </div>
</div>
