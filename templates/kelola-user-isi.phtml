                        </tr>
<?php endforeach ?>
                    </tbody>
                </table>
            </div>
<?php if (($this->aktivitasLagi ?? null) !== null) : ?>
<?php $lagi = $this->alamatKelola . '?tampil=aktivitas' . (($this->saringLingkup ?? '') !== '' ? '&lingkup=' . rawurlencode($this->saringLingkup) : '') . '&jumlah=' . (int) $this->aktivitasLagi . '#aktivitas-' . count($this->aktivitas) ?>
            <div class="text-center mt-3">
                <a class="btn btn-sm btn-outline-secondary" href="<?= $this->escapeHtmlAttr($lagi) ?>">Tampilkan lebih banyak</a>
            </div>
<?php endif ?>
<?php endif ?>
<?php else : ?>
            <section>
            <h2 class="h5 card-title">Tambah user</h2>
<?php $adaWebsite = $websiteTersedia !== [] ?>
            <p class="small text-body-secondary">Bila email sudah terdaftar, user itu cukup diberi akses<?= $adaWebsite ? ' ke dashboard ini atau website yang dipilih' : ' ke sini' ?>. Bila belum, akunnya dibuat <?= ($this->pakaiUndangan ?? false) ? 'dan undangan dikirim ke email itu, berisi tautan untuk membuat kata sandinya sendiri.' : 'dengan kata sandi sementara.' ?></p>
            <form method="post" action="<?= $aksi ?>" class="row g-2 align-items-end">
                <?= $csrf ?>
                <input type="hidden" name="aksi" value="tambah">
                <div class="col-12 <?= $adaWebsite ? 'col-md-6 col-xl-3' : 'col-md-4' ?>">
                    <label class="form-label" for="kelola-email">Email</label>
                    <input class="form-control" id="kelola-email" name="email" type="email" maxlength="190" autocomplete="off" required value="<?= $this->escapeHtmlAttr($this->formEmail) ?>">
                </div>
