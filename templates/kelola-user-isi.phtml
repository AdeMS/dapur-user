                // untuk website. Peran lain tetap terlihat tetapi tidak bisa dipilih. Server tetap memeriksa ulang.
                (() => {
                    const lingkup = document.getElementById('kelola-lingkup');
                    const peran   = document.getElementById('kelola-peran');
                    const atur = () => {
                        const untuk = lingkup.selectedIndex === 0 ? 'dashboard' : 'website';
                        for (const o of peran.options) {
                            o.disabled = o.dataset.untuk !== 'semua' && o.dataset.untuk !== untuk;
                            o.textContent = o.dataset.label + (o.disabled ? (o.dataset.untuk === 'website' ? ' (pilih website)' : ' (hanya dashboard)') : '');
                        }
                        if (peran.selectedOptions[0]?.disabled) {
                            peran.value = 'anggota';
                        }
                    };
                    lingkup.addEventListener('change', atur);
                    atur();
                })();
