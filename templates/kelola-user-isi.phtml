<?php
/**
 * Isi halaman kelola user, dengan dua tab: Daftar User (tambah user + daftar user di lingkup ini; di dashboard utama
 * admin super melihat semua akun) dan Aktivitas Terakhir. Tindakan per user ada di menu dropdown.
 *
 * @var bool $ditolak                       true bila user yang membuka bukan admin
 * @var string|null $belumSiap              pesan bila tabel yang diperlukan belum dibuat
 * @var string|null $pesan                  pesan berhasil
 * @var string|null $galat                  pesan kesalahan
 * @var array{email: string, sandi: string}|null $sandiBaru  kata sandi sementara user baru, tampil sekali
 * @var list<array<string, mixed>> $daftarUser
 * @var list<array<string, mixed>> $aktivitas
 * @var array<string, string> $peranTersedia   nilai peran => label, untuk lingkup ini
 * @var bool $kelolaAkun                    boleh mengaktifkan dan menonaktifkan akun
 * @var string $lingkup
 * @var string $alamatKelola
 * @var string $zonaWaktu
 * @var list<array<string, mixed>>|null $semuaAkun  semua akun (admin super di dashboard utama), atau null
 * @var string $tampil                      tab yang terbuka: 'akses' atau 'aktivitas'
 * @var string $formEmail
 * @var string $formNama
 * @var string $formPeran
 * @var bool $pakaiUndangan                 user baru menerima undangan lewat email
 * @var string $tokenCsrf
 * @var string $fieldCsrf
 */
$csrf = '<input type="hidden" name="' . $this->escapeHtmlAttr($this->fieldCsrf) . '" value="'
    . $this->escapeHtmlAttr($this->tokenCsrf) . '">';
$aksi = $this->escapeHtmlAttr($this->alamatKelola);
$cari = $this->cari ?? '';
// Nama user di daftar: foto kecil, lalu nama (nama di website ini bila ada) yang membuka halaman profilnya.
$namaUser = function (array $a): string {
    $nama = $a['namaTampil'] ?? $a['nama'];
    $h    = '<div class="fw-semibold d-flex align-items-center gap-2">'
        . $this->partial('user::avatar', ['foto' => $a['foto'] ?? null, 'inisial' => $a['inisial'] ?? '', 'kelas' => 'user-avatar-daftar flex-shrink-0']);
    $h .= ($this->alamatProfil ?? null) !== null
        ? '<a class="link-body-emphasis text-decoration-none" href="' . $this->escapeHtmlAttr($this->alamatProfil . '?id=' . (int) $a['id']) . '">' . $this->escapeHtml($nama) . '</a>'
        : '<span>' . $this->escapeHtml($nama) . '</span>';

    $h .= ($a['diriSendiri'] ? ' <span class="badge text-bg-secondary">Anda</span>' : '') . '</div>';

    // Status singkat user, kecil di bawah nama (sejajar dengan nama, sesudah foto).
    return $h . (($a['status'] ?? '') !== ''
        ? '<div class="small fst-italic text-body-secondary text-break user-daftar-status" style="margin-left: 2.25rem"><span class="visually-hidden">Status: </span>' . $this->escapeHtml($a['status']) . '</div>'
        : '');
};
// Kotak cari (GET ke halaman ini).
$formCari = function (int $hasil, string $satuan) use ($cari, $aksi): string {
    $h  = '<form method="get" action="' . $aksi . '" class="d-flex flex-wrap gap-2 mb-3" role="search">';
    $h .= '<input class="form-control form-control-sm" style="max-width: 20rem" type="search" name="cari" maxlength="100" placeholder="Cari nama atau email" aria-label="Cari nama atau email" value="' . $this->escapeHtmlAttr($cari) . '">';
    $h .= '<button type="submit" class="btn btn-sm btn-outline-success"><i class="bi bi-search me-1" aria-hidden="true"></i>Cari</button>';
    if ($cari !== '') {
        $h .= '<a class="btn btn-sm btn-outline-secondary" href="' . $aksi . '">Hapus pencarian</a>';
        $h .= '<span class="small text-body-secondary align-self-center">' . $hasil . ' ' . $satuan . ' cocok dengan <em>' . $this->escapeHtml($cari) . '</em></span>';
    }

    return $h . '</form>';
};
$warnaPeristiwa = [
    'buat_user'   => 'success',
    'beri_akses'  => 'success',
    'ubah_peran'  => 'info',
    'ubah_nama'   => 'secondary',
    'cabut_akses' => 'danger',
    'aktifkan'    => 'success',
    'nonaktifkan' => 'warning',
    'undang'      => 'info',
    'ubah_email'  => 'secondary',
    'tambah_email'  => 'secondary',
    'ubah_foto'     => 'secondary',
    'ubah_profil'   => 'secondary',
    'gabung_akun'   => 'warning',
    'hapus_email'   => 'secondary',
    'email_utama'   => 'secondary',
    'email_website' => 'secondary',
];
?>
<div class="container py-4">
