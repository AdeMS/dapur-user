        <div class="small mt-1">Kata sandi ini hanya ditampilkan sekali. Sampaikan kepada user tersebut, lalu minta ia menggantinya di halaman Pengaturan &amp; Privasi setelah login.</div>
    </div>
<?php endif ?>
<?php
// Dua tab, dimuat ulang dari server (?tampil=aktivitas). Di dashboard utama, admin super melihat SEMUA akun di tab
// Daftar User (termasuk akun yang hanya punya akses ke website); di website, hanya user website itu.
$semuaAkun = $this->semuaAkun ?? null;
$utama     = $semuaAkun !== null;
$tampil    = ($this->tampil ?? 'akses') === 'aktivitas' ? 'aktivitas' : 'akses';
$tabs      = ['akses' => 'Daftar User', 'aktivitas' => 'Aktivitas Terakhir'];
$baris     = $utama ? $semuaAkun : $this->daftarUser;
$websiteTersedia = $this->websiteTersedia ?? [];
$peranWebsite    = $this->peranWebsite ?? ['admin_web' => 'Admin Web', 'anggota' => 'Anggota'];
// Petunjuk batasan domain email website di daftar pilihan, misalnya " (hanya @kantor.co.id)".
$petunjukDomain = static fn (array $w): string => ! $w['terbaca']
    ? ' (pengaturan tidak terbaca)'
    : ($w['domain'] === [] ? '' : ' (hanya ' . implode(', ', array_map(static fn (string $d): string => '@' . $d, $w['domain'])) . ')');
$warnaPeran = static fn (string $p): string => $p === 'anggota' ? 'info' : ($p === 'admin_super' ? 'warning' : 'success');

$popup = [];

// Popup "Atur akses website" untuk satu akun (dashboard utama, admin super): akses website yang sudah ada (ubah
// peran dan email, cabut) dan form beri akses ke website lain.
$popupWebsite = function (array $a) use ($aksi, $csrf, $websiteTersedia, $peranWebsite, $petunjukDomain): string {
    $id    = (int) $a['id'];
    $e     = fn (string $t): string => $this->escapeHtml($t);
    $ea    = fn (string $t): string => $this->escapeHtmlAttr($t);
    $hidden = static fn (string $aksiForm, string $host): string => $csrf . '<input type="hidden" name="aksi" value="' . $aksiForm . '">'
        . '<input type="hidden" name="user_id" value="' . $id . '"><input type="hidden" name="website" value="' . htmlspecialchars($host, ENT_QUOTES) . '">';
    $pilihPeran = function (string $nama, string $terpilih) use ($peranWebsite, $ea, $e): string {
        $h = '<select class="form-select form-select-sm" name="peran" aria-label="Peran">';
        foreach ($peranWebsite as $p => $label) {
            $h .= '<option value="' . $ea($p) . '"' . ($p === $terpilih ? ' selected' : '') . '>' . $e($label) . '</option>';
        }

        return $h . '</select>';
    };
    $pilihEmail = function (?string $terpilih) use ($a, $ea, $e): string {
        $h = '<select class="form-select form-select-sm" name="email" aria-label="Email untuk website ini">';
        foreach ($a['semuaEmail'] as $em) {
            $utama = $em === $a['email'];
            $h .= '<option value="' . ($utama ? '' : $ea($em)) . '"' . (($terpilih ?? $a['email']) === $em ? ' selected' : '') . '>' . $e($em . ($utama ? ' (utama)' : '')) . '</option>';
        }

        return $h . '</select>';
    };

    $dimiliki = [];
    $baris    = '';
    foreach ($a['akses'] as $x) {
        if (! in_array($x['lingkup'], array_column($websiteTersedia, 'host'), true)) {
            continue;
        }
        $host       = $x['lingkup'];
        $dimiliki[] = $host;
        $tanya      = $ea(json_encode('Cabut akses ' . $a['nama'] . ' ke ' . $host . '? Akunnya tidak dihapus.'));
        $baris .= '<li class="list-group-item px-0">'
            . '<div class="fw-semibold mb-2"><i class="bi bi-globe me-1" aria-hidden="true"></i>' . $e($host) . '</div>'
            . '<form method="post" action="' . $aksi . '" class="row g-2 align-items-center" autocomplete="off">' . $hidden('akses_website', $host)
            . '<div class="col-12 col-sm-4">' . $pilihPeran('peran', $x['peran']) . '</div>'
            . '<div class="col-12 col-sm-8">' . $pilihEmail($x['email'] ?? null) . '</div>'
            . '<div class="col-12 d-flex gap-2 justify-content-end">'
            . '<button type="submit" class="btn btn-sm btn-success">Simpan</button>'
            . '<button type="submit" class="btn btn-sm btn-outline-danger" form="cabut-website-' . $id . '-' . $ea(md5($host)) . '">Cabut akses</button>'
            . '</div></form>'
            . '<form method="post" action="' . $aksi . '" id="cabut-website-' . $id . '-' . $ea(md5($host)) . '" onsubmit="return confirm(' . $tanya . ')">' . $hidden('cabut_website', $host) . '</form>'
            . '</li>';
    }

    $sisa = array_values(array_filter($websiteTersedia, static fn (array $w): bool => ! in_array($w['host'], $dimiliki, true)));
    $beri = '';
    if ($sisa !== []) {
        $opsi = '';
        foreach ($sisa as $w) {
            $opsi .= '<option value="' . $ea($w['host']) . '">' . $e($w['host'] . $petunjukDomain($w)) . '</option>';
        }
        $beri = '<hr class="my-3"><h3 class="h6">Beri akses ke website lain</h3>'
            . '<p class="small text-body-secondary mb-2">Website yang belum bisa diakses akun ini.</p>'
            . '<form method="post" action="' . $aksi . '" class="row g-2" autocomplete="off">' . $csrf
            . '<input type="hidden" name="aksi" value="akses_website"><input type="hidden" name="user_id" value="' . $id . '">'
            . '<div class="col-12"><label class="form-label small mb-1" for="beri-website-' . $id . '">Website</label>'
            . '<select class="form-select form-select-sm" id="beri-website-' . $id . '" name="website">' . $opsi . '</select></div>'
            . '<div class="col-12 col-sm-4"><label class="form-label small mb-1">Peran</label>' . $pilihPeran('peran', 'anggota') . '</div>'
            . '<div class="col-12 col-sm-8"><label class="form-label small mb-1">Email yang dipakai di website itu</label>' . $pilihEmail(null) . '</div>'
            . '<div class="col-12 text-end"><button type="submit" class="btn btn-sm btn-success">Beri akses</button></div>'
            . '</form>';
    }

    return '<div class="modal fade" id="akses-website-' . $id . '" tabindex="-1" aria-labelledby="akses-website-judul-' . $id . '" aria-hidden="true">'
        . '<div class="modal-dialog modal-dialog-centered modal-dialog-scrollable"><div class="modal-content">'
        . '<div class="modal-header"><h2 class="modal-title h5" id="akses-website-judul-' . $id . '">Akses website: ' . $e($a['nama']) . '</h2>'
        . '<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Tutup"></button></div>'
        . '<div class="modal-body">'
        . '<h3 class="h6">Akses yang sudah dimiliki</h3>'
        . ($baris === '' ? '<p class="small text-body-secondary mb-0">Belum punya akses ke website mana pun.</p>'
            : '<p class="small text-body-secondary mb-1">Ubah peran atau email yang dipakai di website itu, lalu Simpan; atau cabut aksesnya.</p><ul class="list-group list-group-flush">' . $baris . '</ul>')
        . $beri
        . '<p class="small text-body-secondary mt-3 mb-0">Perubahan tercatat di riwayat akun dan terlihat oleh admin website itu. Website dengan batasan domain hanya menerima email dengan domain tersebut.</p>'
        . '</div></div></div></div>';
};

// Menu tindakan satu baris (dropdown). Setiap item adalah form POST tersendiri.
$menuTindakan = function (array $u) use ($aksi, $csrf, $utama): string {
    $item = function (string $nilaiAksi, string $label, string $ikon, array $isian = [], ?string $tanya = null, string $kelas = '') use ($aksi, $csrf, $u): string {
        $h = '<li><form method="post" action="' . $aksi . '"' . ($tanya !== null ? ' onsubmit="return confirm(' . $this->escapeHtmlAttr(json_encode($tanya)) . ')"' : '') . '>' . $csrf
            . '<input type="hidden" name="aksi" value="' . $nilaiAksi . '"><input type="hidden" name="user_id" value="' . (int) $u['id'] . '">';
        foreach ($isian as $nama => $nilai) {
            $h .= '<input type="hidden" name="' . $nama . '" value="' . $this->escapeHtmlAttr($nilai) . '">';
        }

        return $h . '<button type="submit" class="dropdown-item' . $kelas . '"><i class="bi ' . $ikon . ' me-2" aria-hidden="true"></i>' . $this->escapeHtml($label) . '</button></form></li>';
    };

    $atas = [];
    if ($u['bisaAturWebsite'] ?? false) {
        $atas[] = '<li><button type="button" class="dropdown-item" data-bs-toggle="modal" data-bs-target="#akses-website-' . (int) $u['id'] . '">'
            . '<i class="bi bi-globe me-2" aria-hidden="true"></i>Atur akses website…</button></li>';
    }
    if ($u['bisaUbahPeran'] && ($u['peran'] ?? null) !== null) {
        foreach ($this->peranTersedia as $p => $labelPeran) {
            if ($p !== $u['peran']) {
                $atas[] = $item('peran', 'Jadikan ' . $labelPeran . ($utama ? ' di dashboard' : ''), 'bi-person-gear', ['peran' => $p]);
            }
        }
    }
    if ($u['bisaUndang'] ?? false) {
        $atas[] = $item('undang', 'Kirim ulang undangan', 'bi-envelope-arrow-up');
    }

    $bawah = [];
    if ($u['bisaAturAktif']) {
        $bawah[] = $u['aktif']
            ? $item('aktif', 'Nonaktifkan akun', 'bi-person-slash', ['nilai' => '0'], 'Nonaktifkan akun ' . $u['email'] . '? Berlaku di semua website.', ' text-warning-emphasis')
            : $item('aktif', 'Aktifkan akun', 'bi-person-check', ['nilai' => '1'], 'Aktifkan kembali akun ' . $u['email'] . '? Berlaku di semua website.');
    }
    if ($u['bisaCabut']) {
        $bawah[] = $item('cabut', $utama ? 'Cabut akses dashboard' : 'Cabut akses', 'bi-x-circle', [], 'Cabut akses ' . $u['email'] . ' dari sini? Akunnya tidak dihapus.', ' text-danger-emphasis');
    }

    if ($atas === [] && $bawah === []) {
        return '';
    }

    return '<div class="dropdown">'
        . '<button type="button" class="btn btn-sm btn-outline-secondary border-0" data-bs-toggle="dropdown" data-bs-popper-config=\'{"strategy":"fixed"}\' aria-expanded="false" title="Tindakan" aria-label="Tindakan untuk ' . $this->escapeHtmlAttr($u['nama']) . '"><i class="bi bi-three-dots-vertical" aria-hidden="true"></i></button>'
        . '<ul class="dropdown-menu dropdown-menu-end">' . implode('', $atas)
        . ($atas !== [] && $bawah !== [] ? '<li><hr class="dropdown-divider"></li>' : '') . implode('', $bawah) . '</ul></div>';
};
?>
